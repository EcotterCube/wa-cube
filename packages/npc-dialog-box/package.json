{
    "name": "@workadventure/npc-dialog-box",
    "version": "0.1.0",
    "description": "Reusable video-game-like NPC dialog box for WorkAdventure maps",
    "license": "MIT",
    "type": "module",
    "main": "./dist/api.js",
    "types": "./dist/api.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/api.d.ts",
            "default": "./dist/api.js"
        },
        "./vite": {
            "types": "./dist/vite-plugin.d.ts",
            "default": "./dist/vite.js"
        },
        "./npc-dialog.html": "./dist/npc-dialog.html"
    },
    "scripts": {
        "build": "node build.mjs && tsc -p tsconfig.json",
        "prepare": "npm run build"
    },
    "peerDependencies": {
        "@workadventure/iframe-api-typings": ">=1.26.0",
        "vite": ">=5.0.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@workadventure/iframe-api-typings": "^1.33.2",
        "esbuild": "^0.25.0",
        "typescript": "^5.9.2",
        "vite": "^7.3.0"
    }
}
