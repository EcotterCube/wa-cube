{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2020", "DOM"],
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "./dist"
    },
    "include": ["src/**/*.ts"]
}
